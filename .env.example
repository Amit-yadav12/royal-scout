# Copy the relevant section to your deployment/local environment. No real credentials.

# --- Vercel (web/ root) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
NEXT_PUBLIC_APP_URL=https://your-vercel-domain
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_private_key
SUPABASE_UPLOAD_BUCKET=uploads
SUPABASE_ARTIFACT_BUCKET=royal-scout-artifacts
WORKER_API_URL=https://your-render-domain
WORKER_SHARED_SECRET=replace-with-a-long-random-secret
ROYAL_SCOUT_PROJECT_ID=royal-scout

# --- Render (engine/ root) ---
RS_ENV=production
RS_STORAGE_ROOT=/tmp/royal-scout
RS_USE_SUPABASE_QUEUE=1
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_private_key
SUPABASE_UPLOAD_BUCKET=uploads
SUPABASE_ARTIFACT_BUCKET=royal-scout-artifacts
WORKER_SHARED_SECRET=replace-with-the-same-long-random-secret
RS_MAX_FILE_BYTES=104857600
RS_MAX_EXTRACTED_BYTES=536870912
RS_MAX_ARCHIVE_ENTRIES=500
RS_MAX_FILES_PER_UPLOAD=200
RS_MAX_UPLOAD_FILES=200
RS_MAX_NESTED_DEPTH=3
RS_MAX_COMPRESSION_RATIO=200

# --- Local development ---
RS_ENV=development
RS_STORAGE_ROOT=./storage
# LocalQueue is available only when Supabase queue is disabled or not configured.
RS_USE_SUPABASE_QUEUE=0
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_private_key
SUPABASE_UPLOAD_BUCKET=uploads
SUPABASE_ARTIFACT_BUCKET=royal-scout-artifacts
WORKER_API_URL=http://localhost:8080
WORKER_SHARED_SECRET=replace-with-a-long-random-secret
