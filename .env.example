# ============================================================================
# ROYAL SCOUT — environment template. Copy to .env.local (web) / .env (worker).
# NEVER commit real credentials.
# ============================================================================

# ---------------------------------------------------------------- WEB (Vercel)
# Public Supabase project URL and the *publishable/anon* key. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only. Used for signed upload URLs and metadata writes. NEVER prefix
# this with NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_UPLOAD_BUCKET=uploads
SUPABASE_ARTIFACT_BUCKET=royal-scout-artifacts
RS_MAX_FILES_PER_UPLOAD=200
RS_MAX_UPLOAD_FILE_BYTES=2147483648
RS_MAX_UPLOAD_TOTAL_BYTES=10737418240

# Worker API. The web tier only submits jobs and reads status from here.
WORKER_API_URL=http://localhost:8080
WORKER_SHARED_SECRET=change-me-to-a-long-random-string

# Optional: pin which dataset bundle the dashboard reads from Supabase Storage
# when the bundled static snapshot is not used.
ROYAL_SCOUT_PROJECT_ID=royal-scout-demo
ROYAL_SCOUT_DATASET_ID=ds_fixture_demo

# -------------------------------------------------------------- WORKER (Railway)
# Same Supabase project; the worker needs the service role key for storage + queue.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ARTIFACT_BUCKET=royal-scout-artifacts
SUPABASE_UPLOAD_BUCKET=uploads
RS_STORAGE_ROOT=/data/storage
RS_USE_SUPABASE_QUEUE=1
RS_ENV=production
WORKER_SHARED_SECRET=change-me-to-a-long-random-string

# Configurable ingestion limits (bytes / counts). Tune to your worker's disk+RAM.
RS_MAX_FILE_BYTES=2147483648
RS_MAX_EXTRACTED_BYTES=21474836480
RS_MAX_ARCHIVE_ENTRIES=5000
RS_MAX_FILES_PER_UPLOAD=5000
RS_MAX_NESTED_DEPTH=3
RS_MAX_COMPRESSION_RATIO=200
